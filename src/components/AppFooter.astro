---
import { site } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-alp-border bg-alp-surface">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-6 py-10 md:flex-row md:items-center md:justify-between md:px-12 xl:px-6">
    <div class="flex items-center gap-4">
      <img
        src="/images/alp/brand/alp-logo-primary.png"
        alt="Agribusiness Leadership Program"
        class="h-9 w-auto"
        width="1200"
        height="332"
        loading="lazy"
      />
      <p class="text-sm text-alp-muted">
        ALP Coach is the AI learning assistant of the {site.programme}.
      </p>
    </div>
    <div class="flex flex-col gap-1 text-sm text-alp-muted md:items-end">
      <p>
        Built and operated by
        <a href="https://intaigent.com" target="_blank" rel="noopener" class="font-semibold text-alp-navy hover:text-alp-green">intaigent</a>
      </p>
      <p>&copy; {year} intaigent. All rights reserved.</p>
    </div>
  </div>
</footer>
