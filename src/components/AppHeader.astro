---
import { site } from "../config/site";

const links = [
  { to: "#how-it-works", label: "How it works" },
  { to: "#curriculum", label: "Curriculum" },
  { to: "#try", label: "Try it" },
  { to: "#field", label: "In the field" },
  { to: "#analytics", label: "Analytics" },
  { to: "#bring", label: "For programmes" },
];

const tryHref = site.telegram.live ? site.telegram.url : "#try";
---

<header class="sticky top-0 z-50 border-b border-alp-border/70 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-3 md:px-12 xl:px-6">
    <a href="#top" aria-label="ALP Coach home" class="flex items-center gap-3">
      <img
        src="/images/alp/brand/alp-logo-primary.png"
        alt="Agribusiness Leadership Program"
        class="h-9 w-auto md:h-10"
        width="1200"
        height="332"
      />
      <span class="hidden h-6 w-px bg-alp-border sm:block"></span>
      <span class="hidden text-lg font-bold tracking-tight text-alp-navy sm:block">Coach</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.to}
            class="rounded-full px-3 py-2 text-sm font-semibold text-alp-navy/80 transition hover:bg-alp-surface hover:text-alp-navy"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={tryHref}
        target={site.telegram.live ? "_blank" : undefined}
        rel={site.telegram.live ? "noopener" : undefined}
        class="inline-flex h-10 items-center whitespace-nowrap rounded-full bg-alp-green px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-alp-navy sm:px-5"
      >
        <span class="sm:hidden">Try it</span>
        <span class="hidden sm:inline">Try ALP Coach</span>
      </a>
      <button
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-alp-border text-alp-navy lg:hidden"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="border-t border-alp-border bg-white lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-6 py-3" aria-label="Mobile">
      {
        links.map((link) => (
          <a href={link.to} class="rounded-lg px-3 py-3 text-base font-semibold text-alp-navy hover:bg-alp-surface">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
    };
    toggle.addEventListener("click", () => setOpen(menu.hidden));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  }
</script>
