<section id="chatbot" class="py-16 relative">
  <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-40">
    <div class="blur-[106px] h-56 bg-gradient-to-br from-blue-400 via-purple-200 to-green-400"></div>
    <div class="blur-[106px] h-32 bg-gradient-to-r from-white via-green-400 to-blue-400"></div>
  </div>
  <div class="container mx-auto px-4 relative z-10">
    <div class="flex items-center justify-center mb-12">
      <img src="/images/agriconnect/chatbotArtboard 1.svg" alt="Chatbot Icon" class="w-12 h-12 mr-4">
      <h2 class="text-4xl font-bold text-center text-gray-800">AI Coaches That Speak, Listen, and Show</h2>
    </div>
    
    <div class="flex flex-col md:flex-row justify-between items-start gap-8">
      {/* Left side - Demo Video */}
      <div class="w-full md:w-1/2">
        <div class="relative w-full h-[600px] mx-auto max-w-[280px]">
          <!-- Phone container with modern white border -->
          <div class="w-full h-full bg-gradient-to-br from-white via-gray-50 to-gray-100 rounded-[32px] p-1 shadow-[0_20px_40px_rgba(0,0,0,0.08),0_8px_16px_rgba(0,0,0,0.04),inset_0_1px_0_rgba(255,255,255,0.8)]">
            <!-- Screen area -->
            <div class="relative w-full h-full rounded-[28px] overflow-hidden shadow-inner">
              <!-- Notch -->
              <div class="absolute top-2 left-1/2 transform -translate-x-1/2 w-20 h-3 bg-gray-800 rounded-full z-20"></div>
              
              <!-- Video -->
              <video 
                src="/Demo_ALP_logo_cut.mp4" 
                alt="ALP Coach Demo" 
                class="w-full h-full object-cover rounded-[28px]"
                style="clip-path: inset(6% 0 0 0); filter: brightness(1.05) contrast(1.15); image-rendering: crisp-edges;"
                autoplay
                loop
                muted
                playsinline
              />
            </div>
          </div>
        </div>
      </div>

      {/* Right side - Key Features */}
      <div class="w-full md:w-1/2">
        <h2 class="text-2xl font-bold mb-8">Key Features</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-xl shadow-md">
            <div class="text-4xl mb-4">🌍</div>
            <h3 class="font-semibold text-lg mb-2">Multi-lingual</h3>
            <p class="text-gray-600">Support in various languages</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md">
            <div class="text-4xl mb-4">🎙️</div>
            <h3 class="font-semibold text-lg mb-2">Multi-modal</h3>
            <p class="text-gray-600">Text, voice, and image interactions</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md">
            <div class="text-4xl mb-4">💬</div>
            <h3 class="font-semibold text-lg mb-2">Multi-platform</h3>
            <p class="text-gray-600">Works with WhatsApp, Telegram, WeChat, Line, and iMessage</p>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-md">
            <div class="text-4xl mb-4">⏰</div>
            <h3 class="font-semibold text-lg mb-2">Always Available</h3>
            <p class="text-gray-600">24/7 support for learners</p>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Section - Try the Bot -->
    <div class="mt-16 bg-gradient-to-r from-blue-50 to-green-50 rounded-3xl p-8 mx-4">
      <div class="text-center">
        <h3 class="text-2xl font-bold text-gray-800 mb-4">Ready to Experience ALP Coach?</h3>
        <p class="text-gray-600 mb-6">Start learning with our AI-powered coach in seconds</p>
        
        <div class="flex flex-col md:flex-row items-center justify-center gap-8">
          <!-- QR Code -->
          <div class="flex flex-col items-center">
            <div class="bg-white p-4 rounded-xl shadow-lg">
              <img src="/images/agriconnect/t_me-alp_blf_pilot_bot.jpg" 
                   alt="QR Code to ALP Coach Bot" 
                   class="w-40 h-40 object-cover"
                   style="clip-path: inset(13% 12% 20% 12%);">
            </div>
            <p class="text-sm text-gray-500 mt-2">Scan with your phone</p>
          </div>
          
          <!-- Direct Link Button -->
          <div class="flex flex-col items-center">
            <a href="https://t.me/alp_blf_pilot_bot" 
               target="_blank" 
               class="relative inline-flex items-center px-8 py-4 text-lg font-semibold text-white bg-blue-600 rounded-full shadow-lg transition-all duration-300 hover:bg-blue-700 hover:scale-105 active:scale-95">
              <svg class="w-6 h-6 mr-3" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.374 0 0 5.373 0 12s5.374 12 12 12 12-5.373 12-12S18.626 0 12 0zm5.568 8.16l-1.61 7.56c-.12.55-.45.68-.9.42l-2.5-1.84-1.2 1.16c-.13.13-.25.25-.5.25l.18-2.5 4.6-4.16c.2-.18-.04-.28-.3-.1L8.7 13.14l-2.48-.78c-.54-.17-.55-.54.11-.8l9.68-3.72c.45-.17.84.1.7.82z"/>
              </svg>
              Open in Telegram
            </a>
            <p class="text-sm text-gray-500 mt-2">Click to start chatting</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

