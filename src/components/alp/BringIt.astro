---
import { site } from "../../config/site";

const steps = [
  {
    n: "1",
    title: "Request access",
    body: "Tell us the project, the country and who the learners are. The full ALP content for every learner group is already in the bot, so there is nothing to build.",
  },
  {
    n: "2",
    title: "Share it with your learners",
    body: "Learners join from a QR code or a link and register in a minute. English is available now; if your language is not there yet, request it and ALP adds it to the pipeline.",
  },
  {
    n: "3",
    title: "Follow progress in the dashboard",
    body: "Your project team gets the analytics dashboard from day one: who is learning, how far they get, and what they ask.",
  },
];

const subject = encodeURIComponent("ALP Coach for our project");
---

<section id="bring" class="reveal py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 md:px-12 xl:px-6">
    <div class="overflow-hidden rounded-[32px] bg-alp-navy text-white">
      <div class="grid gap-10 p-8 sm:p-12 lg:grid-cols-12 lg:items-center lg:p-16">
        <div class="lg:col-span-5">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-bright">For project teams</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
            Bring ALP Coach to your project
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-white/75">
            One bot per channel carries the complete ALP content for every learner group. For a World Bank
            task team, adding ALP Coach to a project means getting access, not commissioning a build.
          </p>
          <a
            href={`mailto:${site.contactEmail}?subject=${subject}`}
            class="mt-8 inline-flex h-12 items-center rounded-full bg-alp-bright px-6 text-base font-bold text-alp-navy transition hover:bg-white"
          >
            Talk to the ALP Coach team
          </a>
          <p class="mt-3 text-sm text-white/60">{site.contactEmail}</p>
        </div>
        <ol class="grid gap-4 lg:col-span-7">
          {
            steps.map((s) => (
              <li class="flex gap-5 rounded-2xl border border-white/10 bg-white/5 p-5">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-alp-bright text-base font-extrabold text-alp-navy">{s.n}</span>
                <div>
                  <h3 class="font-bold">{s.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-white/70">{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
