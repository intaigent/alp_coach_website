---
import { site } from "../../config/site";
---

<section id="curriculum" class="reveal bg-alp-navy py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-6 md:px-12 xl:px-6">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-bright">Curriculum</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
          The complete ALP digital learning content, inside the chat
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-white/75">
          The same curriculum ALP uses with cooperatives, producer organisations and agri-enterprises,
          organised the way learners already know it: learning path, category, course, lesson, quiz.
        </p>
        <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-white/15 pt-8">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-white/60">Learning paths</dt>
            <dd class="mt-1 text-3xl font-extrabold text-alp-bright">{site.learningPaths.length}</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-white/60">Formats</dt>
            <dd class="mt-1 text-base font-semibold">Text, audio, images, video</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-white/60">Source</dt>
            <dd class="mt-1 text-base font-semibold">Validated ALP content only</dd>
          </div>
        </dl>
      </div>

      <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-7 lg:grid-cols-3">
        {
          site.learningPaths.map((lp, i) => (
            <li class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 px-4 py-4 transition hover:border-alp-bright/60 hover:bg-white/10">
              <span class="font-mono text-xs font-semibold tabular-nums text-alp-bright" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="text-sm font-semibold leading-snug">{lp.title}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
