---
import { site } from "../../config/site";
const paths = site.learningPaths;
const per = Math.ceil(paths.length / 2);
const columns = [paths.slice(0, per), paths.slice(per)];
const categoryCount = paths.reduce((n, p) => n + p.categories.length, 0);
---

<section id="curriculum" class="reveal bg-alp-navy py-20 text-white lg:py-24">
  <div class="mx-auto max-w-7xl px-6 md:px-12 xl:px-6">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-bright">Curriculum</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
          The complete ALP digital learning content, inside the chat
        </h2>
        <p class="mt-5 text-base leading-relaxed text-white/70">
          The same curriculum ALP uses with cooperatives, producer organisations and agri-enterprises,
          in its original structure: learning path, category, course, lesson, quiz.
        </p>
        <p class="mt-3 text-sm text-white/50">Select a learning path to see its categories.</p>

        <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-white/15 pt-8">
          <div>
            <dt class="text-xs text-white/60">Learning paths</dt>
            <dd class="mt-1 text-2xl font-extrabold tabular-nums text-alp-bright">{paths.length}</dd>
          </div>
          <div>
            <dt class="text-xs text-white/60">Categories</dt>
            <dd class="mt-1 text-2xl font-extrabold tabular-nums text-alp-bright">{categoryCount}</dd>
          </div>
          <div>
            <dt class="text-xs text-white/60">Formats</dt>
            <dd class="mt-1 text-sm font-semibold leading-snug">Text, audio, images, video</dd>
          </div>
        </dl>
      </div>

      <div class="grid gap-x-12 md:grid-cols-2 lg:col-span-8" data-curriculum>
        {
          columns.map((col, c) => (
            <ol class="divide-y divide-white/10 border-t border-white/10">
              {col.map((lp, i) => {
                const n = c * per + i + 1;
                const id = `lp-${n}`;
                return (
                  <li>
                    <button
                      type="button"
                      class="group flex w-full items-center gap-6 py-5 text-left transition-colors hover:text-alp-bright"
                      aria-expanded="false"
                      aria-controls={id}
                    >
                      <span class="w-8 shrink-0 text-xs font-semibold tabular-nums tracking-widest text-alp-bright/80">
                        {String(n).padStart(2, "0")}
                      </span>
                      <span class="flex-1 text-lg font-semibold leading-snug">{lp.title}</span>
                      <span class="hidden shrink-0 text-xs text-white/40 transition-colors group-hover:text-alp-bright xl:inline">
                        {lp.categories.length} categories
                      </span>
                      <svg class="h-4 w-4 shrink-0 text-white/40 transition-transform duration-300 group-hover:text-alp-bright" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 9l6 6 6-6" />
                      </svg>
                    </button>
                    <div id={id} class="lp-panel" hidden>
                      <ul class="mb-5 ml-14 space-y-2 border-l border-alp-bright/40 pl-5">
                        {lp.categories.map((cat) => (
                          <li class="text-sm text-white/85">{cat.name}</li>
                        ))}
                      </ul>
                    </div>
                  </li>
                );
              })}
            </ol>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  button[aria-expanded="true"] svg {
    transform: rotate(180deg);
    color: #00bb33;
  }
  .lp-panel {
    animation: lp-open 0.25s ease-out;
  }
  @keyframes lp-open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-panel {
      animation: none;
    }
  }
</style>

<script>
  // One learning path open at a time; click or tap toggles it.
  const root = document.querySelector<HTMLElement>("[data-curriculum]");
  if (root) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[aria-controls]"));
    const setOpen = (btn: HTMLButtonElement, open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      const panel = document.getElementById(btn.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = !open;
    };
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") !== "true";
        buttons.forEach((b) => setOpen(b, false));
        setOpen(btn, open);
      });
    });
  }
</script>
