---
import { site } from "../../config/site";
const paths = site.learningPaths;
const half = Math.ceil(paths.length / 2);
const columns = [paths.slice(0, half), paths.slice(half)];
---

<section id="curriculum" class="reveal bg-alp-navy py-24 text-white lg:py-32">
  <div class="mx-auto max-w-7xl px-6 md:px-12 xl:px-6">
    <div class="grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-bright">Curriculum</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
          The complete ALP digital learning content, inside the chat
        </h2>
        <p class="mt-5 text-base leading-relaxed text-white/70">
          The same curriculum ALP uses with cooperatives, producer organisations and agri-enterprises,
          organised the way learners already know it: learning path, category, course, lesson, quiz.
        </p>

        <dl class="mt-10 space-y-5 border-t border-white/15 pt-8">
          <div class="flex items-baseline justify-between gap-6">
            <dt class="text-sm text-white/60">Learning paths</dt>
            <dd class="text-2xl font-extrabold tabular-nums text-alp-bright">{paths.length}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-6">
            <dt class="text-sm text-white/60">Formats</dt>
            <dd class="text-right text-sm font-semibold">Text, audio, images, video</dd>
          </div>
          <div class="flex items-baseline justify-between gap-6">
            <dt class="text-sm text-white/60">Source</dt>
            <dd class="text-right text-sm font-semibold">Validated ALP content only</dd>
          </div>
        </dl>
      </div>

      <div class="grid gap-x-12 md:grid-cols-2 lg:col-span-8">
        {
          columns.map((col, c) => (
            <ol class="divide-y divide-white/10 border-t border-white/10">
              {col.map((lp, i) => (
                <li class="group flex items-center gap-6 py-5">
                  <span class="w-8 shrink-0 text-xs font-semibold tabular-nums tracking-widest text-alp-bright/80">
                    {String(c * half + i + 1).padStart(2, "0")}
                  </span>
                  <span class="flex-1 text-lg font-semibold leading-snug transition-colors group-hover:text-alp-bright">
                    {lp.title}
                  </span>
                  <span class="h-px w-6 bg-white/20 transition-all group-hover:w-10 group-hover:bg-alp-bright" aria-hidden="true"></span>
                </li>
              ))}
            </ol>
          ))
        }
      </div>
    </div>
  </div>
</section>
