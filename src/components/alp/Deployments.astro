---
import { site } from "../../config/site";
const cols = [
  { key: "since", label: "Since" },
  { key: "channels", label: "Channel" },
  { key: "languages", label: "Languages" },
  { key: "audience", label: "Learners" },
] as const;
---

<section id="field" class="reveal py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 md:px-12 xl:px-6">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-green">In the field</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-alp-navy sm:text-4xl">
          Already coaching in two countries
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-alp-muted">
          The AI coach is already in use in country deployments, with real learners since 2024: in
          Swahili on Telegram in Tanzania, and in Bengali on WhatsApp in Bangladesh. Both run on the
          platform behind the full ALP Coach, one bot per channel.
        </p>
      </div>

      <div class="lg:col-span-7">
        <div class="overflow-hidden rounded-3xl border border-alp-border bg-white shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-alp-border bg-alp-surface text-[11px] font-semibold uppercase tracking-wider text-alp-muted">
                  <th scope="col" class="px-6 py-3">Country</th>
                  {cols.map((c) => <th scope="col" class="px-4 py-3">{c.label}</th>)}
                </tr>
              </thead>
              <tbody class="divide-y divide-alp-border">
                {
                  site.deployments.map((d) => (
                    <tr>
                      <th scope="row" class="px-6 py-4 text-base font-extrabold text-alp-navy">{d.country}</th>
                      {cols.map((c) => <td class="px-4 py-4 font-medium text-alp-navy">{d[c.key]}</td>)}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="border-t border-alp-border bg-alp-surface px-6 py-5">
            <p class="text-sm leading-relaxed text-alp-navy">{site.fieldStory.text}</p>
            <p class="mt-1.5 text-xs text-alp-muted">
              {site.fieldStory.source}.
              <a href={site.fieldStory.url} target="_blank" rel="noopener" class="ml-1 font-semibold text-alp-green hover:text-alp-navy">
                {site.fieldStory.label} <span aria-hidden="true">↗</span>
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
