---
import { site } from "../../config/site";
---

<section id="field" class="reveal py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 md:px-12 xl:px-6">
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-green">In the field</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-alp-navy sm:text-4xl">
        Already coaching in two countries
      </h2>
      <p class="mt-4 text-lg text-alp-muted">
        ALP Coach grew out of country programmes where it has been used by real learners in their own
        language. Those deployments run on the same platform as the full ALP Coach.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        site.deployments.map((d) => (
          <article class="flex flex-col rounded-3xl border border-alp-border bg-white p-8 shadow-sm">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-2xl font-extrabold text-alp-navy">{d.country}</h3>
                <p class="text-sm text-alp-muted">Since {d.since}</p>
              </div>
              <span class="rounded-full bg-alp-bright/15 px-3 py-1 text-xs font-bold text-alp-green">Live</span>
            </div>
            <dl class="mt-6 grid grid-cols-1 gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
              <div>
                <dt class="font-semibold uppercase tracking-wider text-alp-muted text-[11px]">Programme</dt>
                <dd class="mt-0.5 font-semibold text-alp-navy">{d.programme}</dd>
              </div>
              <div>
                <dt class="font-semibold uppercase tracking-wider text-alp-muted text-[11px]">Channels</dt>
                <dd class="mt-0.5 font-semibold text-alp-navy">{d.channels}</dd>
              </div>
              <div>
                <dt class="font-semibold uppercase tracking-wider text-alp-muted text-[11px]">Languages</dt>
                <dd class="mt-0.5 font-semibold text-alp-navy">{d.languages}</dd>
              </div>
              <div>
                <dt class="font-semibold uppercase tracking-wider text-alp-muted text-[11px]">Learners</dt>
                <dd class="mt-0.5 font-semibold text-alp-navy">{d.audience}</dd>
              </div>
            </dl>
            {d.link && (
              <a
                href={d.link}
                target="_blank"
                rel="noopener"
                class="mt-6 inline-flex w-max items-center gap-1 text-sm font-semibold text-alp-green hover:text-alp-navy"
              >
                {d.linkLabel} <span aria-hidden="true">↗</span>
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
