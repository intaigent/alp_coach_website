---
import { site } from "../../config/site";
import PhoneMock from "./PhoneMock.astro";
import Voice from "./Voice.astro";
const { telegram, whatsapp } = site;
const anyLive = telegram.live || whatsapp.live;
---

<section id="top" class="relative overflow-hidden bg-alp-surface">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -left-32 -top-32 h-96 w-96 rounded-full bg-alp-bright/20 blur-3xl"></div>
    <div class="absolute -right-24 top-40 h-[28rem] w-[28rem] rounded-full bg-alp-sky/15 blur-3xl"></div>
  </div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 pb-20 pt-14 md:px-12 lg:grid-cols-12 lg:pb-28 lg:pt-20 xl:px-6">
    <div class="lg:col-span-7">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-alp-border bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-[0.12em] text-alp-green sm:text-xs sm:tracking-[0.18em]">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-alp-bright"></span>
        <span>{site.programme}</span>
      </p>
      <h1 class="text-4xl font-extrabold leading-[1.05] tracking-tight text-alp-navy sm:text-5xl xl:text-6xl">
        The ALP curriculum, delivered as a coach in the chat app you already use.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-alp-muted sm:text-xl">
        ALP Coach turns the full Agribusiness Leadership Program into short lessons, quizzes and a coach
        you can question by text or voice, on WhatsApp and Telegram. Every answer comes from validated ALP
        content, and every interaction is visible to the programme team in one analytics dashboard.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        {
          telegram.live ? (
            <a
              href={telegram.url}
              target="_blank"
              rel="noopener"
              class="inline-flex h-12 items-center gap-2 rounded-full bg-alp-green px-6 text-base font-semibold text-white shadow-lg shadow-alp-green/20 transition hover:bg-alp-navy"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12s5.374 12 12 12 12-5.373 12-12S18.626 0 12 0zm5.568 8.16l-1.61 7.56c-.12.55-.45.68-.9.42l-2.5-1.84-1.2 1.16c-.13.13-.25.25-.5.25l.18-2.5 4.6-4.16c.2-.18-.04-.28-.3-.1L8.7 13.14l-2.48-.78c-.54-.17-.55-.54.11-.8l9.68-3.72c.45-.17.84.1.7.82z" />
              </svg>
              Open ALP Coach in Telegram
            </a>
          ) : (
            <a
              href="#how-it-works"
              class="inline-flex h-12 items-center rounded-full bg-alp-green px-6 text-base font-semibold text-white shadow-lg shadow-alp-green/20 transition hover:bg-alp-navy"
            >
              See how it works
            </a>
          )
        }
        <a
          href={telegram.live ? "#how-it-works" : "#try"}
          class="inline-flex h-12 items-center rounded-full border border-alp-navy/15 bg-white px-6 text-base font-semibold text-alp-navy transition hover:border-alp-navy/40"
        >
          {telegram.live ? "See how it works" : "Get access"}
        </a>
      </div>

      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-alp-muted">
        <li class="flex items-center gap-2"><span class="text-alp-green">✓</span> Full ALP curriculum in English</li>
        <li class="flex items-center gap-2"><span class="text-alp-green">✓</span> Text and voice, in both directions</li>
        <li class="flex items-center gap-2">
          <span class="text-alp-green">✓</span>
          {anyLive ? "WhatsApp and Telegram" : "WhatsApp and Telegram, one bot per channel"}
        </li>
      </ul>
    </div>

    <div class="lg:col-span-5">
      <div class="relative">
        <div aria-hidden="true" class="absolute inset-x-8 -inset-y-6 rounded-[60px] bg-gradient-to-b from-alp-bright/25 via-alp-sky/10 to-transparent blur-2xl"></div>
        <div class="relative" data-hero-phone>
          <PhoneMock live>
            <p class="pm-day">Today</p>
            <div class="pm-bubble pm-user" data-step="typed" data-text="What is the ABC method?" data-time="5:20 PM">
              What is the ABC method?
            </div>
            <div class="pm-bubble pm-coach" data-step="coach" data-time="5:20 PM">
              <p>The ABC method is an inventory management technique that classifies products into three
              categories, A, B and C, based on their value to the business. Category A includes essential
              and high-value products that generate the most revenue and require close management.
              Category B consists of important but less critical items, while Category C comprises
              low-value products that contribute minimally to overall income.</p>
            </div>
            <div class="pm-keys" data-step="keys">
              <span class="pm-key">Listen to the answer</span>
            </div>
            <div class="pm-bubble pm-coach" data-step="coach" data-quick="true" data-time="5:20 PM">
              <p>Want to know more about this topic? Check out this ALP learning video:</p>
              <p><strong>Example of the ABC method of inventory management</strong></p>
            </div>
            <div class="pm-keys" data-step="keys">
              <span class="pm-key">Watch the video</span>
            </div>
            <div class="pm-bubble pm-user pm-voice-only" data-step="user" data-time="5:21 PM" aria-label="Voice message, 6 seconds">
              <Voice time="0:06" bars={20} />
            </div>
            <div class="pm-bubble pm-coach" data-step="coach" data-time="5:21 PM">
              <p>Start with your A items. Count them every week, set a minimum stock level for each one,
              and reorder as soon as you reach it. B items can be checked monthly and C items each quarter.</p>
            </div>
            <div class="pm-keys" data-step="keys">
              <span class="pm-key">Listen to the answer</span>
            </div>
          </PhoneMock>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Plays the hero conversation as a loop. Static (everything shown) when the
  // visitor prefers reduced motion; paused while the phone is off screen.
  const root = document.querySelector<HTMLElement>("[data-hero-phone]");
  if (root) {
    const body = root.querySelector<HTMLElement>(".pm-body")!;
    const field = root.querySelector<HTMLElement>("[data-pm-field]")!;
    const steps = Array.from(body.querySelectorAll<HTMLElement>("[data-step]"));
    const placeholder = field.dataset.placeholder ?? "";
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduced) {
      steps.forEach((s) => s.classList.add("is-on", "is-in"));
    } else {
      let visible = true;
      new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.2 }).observe(root);

      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const waitVisible = async () => {
        while (!visible) await sleep(400);
      };
      const typing = document.createElement("div");
      typing.className = "pm-bubble pm-coach pm-typing";
      typing.setAttribute("aria-hidden", "true");
      typing.innerHTML = "<i></i><i></i><i></i>";

      const showTyping = async (ms: number) => {
        body.appendChild(typing);
        typing.classList.add("is-on");
        await sleep(30);
        typing.classList.add("is-in");
        await sleep(ms);
        typing.classList.remove("is-in", "is-on");
        typing.remove();
      };
      const reveal = async (el: HTMLElement) => {
        body.appendChild(el);
        el.classList.add("is-on");
        await sleep(30);
        el.classList.add("is-in");
      };
      const typeInto = async (text: string) => {
        field.textContent = "";
        field.classList.add("is-typing");
        for (const ch of text) {
          field.textContent += ch;
          await sleep(38 + Math.random() * 30);
        }
        await sleep(450);
        field.classList.remove("is-typing");
        field.textContent = placeholder;
      };

      const play = async () => {
        for (;;) {
          steps.forEach((s) => s.classList.remove("is-in", "is-on"));
          await sleep(500);
          for (const step of steps) {
            await waitVisible();
            const kind = step.dataset.step;
            if (kind === "typed") {
              await typeInto(step.dataset.text ?? step.textContent?.trim() ?? "");
              await reveal(step);
              await sleep(500);
            } else if (kind === "coach") {
              await showTyping(step.dataset.quick ? 700 : 1400);
              await reveal(step);
              await sleep(step.dataset.quick ? 600 : 1200);
            } else if (kind === "keys") {
              await sleep(120);
              await reveal(step);
              await sleep(900);
            } else {
              await sleep(500);
              await reveal(step);
              await sleep(1100);
            }
          }
          await sleep(3200);
          body.classList.add("is-resetting");
          await sleep(450);
          steps.forEach((s) => s.classList.remove("is-in", "is-on"));
          body.classList.remove("is-resetting");
          await sleep(300);
        }
      };
      play();
    }
  }
</script>
