---
import { site } from "../../config/site";
const { telegram, whatsapp } = site;
---

<section id="top" class="relative overflow-hidden bg-alp-surface">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -left-32 -top-32 h-96 w-96 rounded-full bg-alp-bright/20 blur-3xl"></div>
    <div class="absolute -right-24 top-40 h-[28rem] w-[28rem] rounded-full bg-alp-sky/15 blur-3xl"></div>
  </div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 pb-20 pt-14 md:px-12 lg:grid-cols-12 lg:pb-28 lg:pt-20 xl:px-6">
    <div class="lg:col-span-7">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-alp-border bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-[0.12em] text-alp-green sm:text-xs sm:tracking-[0.18em]">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-alp-bright"></span>
        <span>{site.programme}</span>
      </p>
      <h1 class="text-4xl font-extrabold leading-[1.05] tracking-tight text-alp-navy sm:text-5xl xl:text-6xl">
        The ALP curriculum, delivered as a coach in the chat app you already use.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-alp-muted sm:text-xl">
        ALP Coach turns the full Agribusiness Leadership Program into short lessons, quizzes and a coach
        you can question by text or voice, on WhatsApp and Telegram. Every answer comes from validated ALP
        content, and every interaction is visible to the programme team in one analytics dashboard.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        {
          telegram.live && (
            <a
              href={telegram.url}
              target="_blank"
              rel="noopener"
              class="inline-flex h-12 items-center gap-2 rounded-full bg-alp-green px-6 text-base font-semibold text-white shadow-lg shadow-alp-green/20 transition hover:bg-alp-navy"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12s5.374 12 12 12 12-5.373 12-12S18.626 0 12 0zm5.568 8.16l-1.61 7.56c-.12.55-.45.68-.9.42l-2.5-1.84-1.2 1.16c-.13.13-.25.25-.5.25l.18-2.5 4.6-4.16c.2-.18-.04-.28-.3-.1L8.7 13.14l-2.48-.78c-.54-.17-.55-.54.11-.8l9.68-3.72c.45-.17.84.1.7.82z" />
              </svg>
              Open ALP Coach in Telegram
            </a>
          )
        }
        <a
          href="#how-it-works"
          class="inline-flex h-12 items-center rounded-full border border-alp-navy/15 bg-white px-6 text-base font-semibold text-alp-navy transition hover:border-alp-navy/40"
        >
          See how it works
        </a>
      </div>

      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-alp-muted">
        <li class="flex items-center gap-2"><span class="text-alp-green">✓</span> Full ALP curriculum in English</li>
        <li class="flex items-center gap-2"><span class="text-alp-green">✓</span> Text and voice, in both directions</li>
        <li class="flex items-center gap-2">
          <span class="text-alp-green">✓</span>
          {whatsapp.live ? "WhatsApp and Telegram" : `Telegram today, WhatsApp ${whatsapp.launch}`}
        </li>
      </ul>
    </div>

    <div class="lg:col-span-5">
      <div class="relative mx-auto w-[260px] sm:w-[280px]">
        <div aria-hidden="true" class="absolute -inset-6 rounded-[48px] bg-gradient-to-br from-alp-bright/30 via-alp-sky/20 to-transparent blur-2xl"></div>
        <div class="relative rounded-[36px] bg-alp-navy p-2 shadow-2xl shadow-alp-navy/30">
          <div class="relative aspect-[9/17] overflow-hidden rounded-[30px] bg-black">
            <!-- Chat header drawn over the recording so the demo reads as ALP Coach. -->
            <div class="absolute inset-x-0 top-0 z-10 h-[14%] bg-alp-navy">
              <div class="absolute left-1/2 top-2 h-4 w-20 -translate-x-1/2 rounded-full bg-black"></div>
              <div class="absolute inset-x-0 bottom-0 flex h-[55%] items-center justify-between px-4">
                <span class="text-[10px] text-white/60">Back</span>
                <div class="text-center leading-tight">
                  <p class="text-[12px] font-semibold text-white">ALP Coach</p>
                  <p class="text-[9px] text-white/60">bot</p>
                </div>
                <img src="/images/alp/brand/alp-logo-primary.png" alt="" class="h-4 w-auto rounded-sm bg-white px-0.5" />
              </div>
            </div>
            <video
              src={site.demoVideo}
              class="h-full w-full object-cover object-bottom"
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              aria-label="ALP Coach demo"
            ></video>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
