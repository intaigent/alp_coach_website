---
import PhoneMock from "./PhoneMock.astro";
import Voice from "./Voice.astro";
import { site } from "../../config/site";

// Minimal stroke icons (24x24 viewBox paths).
const facts = [
  {
    icon: "M4 5h16v11H8l-4 4V5z",
    title: "WhatsApp and Telegram",
    body: "No app to install. Learners use the messaging app already on their phone.",
  },
  {
    icon: "M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18",
    title: "Language chosen in the bot",
    body: "Learners pick a language at registration and can change it any time.",
  },
  {
    icon: "M12 12a4 4 0 100-8 4 4 0 000 8zM4 21a8 8 0 0116 0",
    title: "A profile, not just a number",
    body: "A one-minute registration captures role, region and background, so the coach and the project team know who is learning.",
  },
  {
    icon: "M12 3a9 9 0 100 18 9 9 0 000-18zM12 7v5l3 3",
    title: "Available around the clock",
    body: "The coach answers at 6 am before market day and at 10 pm after the books are closed.",
  },
];

const cardClass =
  "flex flex-col rounded-3xl border border-alp-border bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-alp-navy/10";
const mockClass = "mb-6 h-[360px] overflow-hidden rounded-2xl bg-alp-surface px-4 pt-6";
---

<section id="how-it-works" class="reveal py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 md:px-12 xl:px-6">
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-green">How it works</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-alp-navy sm:text-4xl">
        One coach, four ways to learn
      </h2>
      <p class="mt-4 text-lg text-alp-muted">
        Learners follow structured courses or simply ask. Both draw on the same validated ALP content.
      </p>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 xl:grid-cols-4">
      <!-- Learn -->
      <article class={cardClass}>
        <div class={mockClass}>
          <PhoneMock compact label="Lesson preview">
            <div class="pm-bubble pm-coach" style="--i: 1" data-time="5:15 PM">
              <Voice time="0:22" bars={18} />
              <p>Please choose your learning path:</p>
              <ol class="pm-list">
                {site.learningPaths.map((lp, i) => <li>{i + 1}. {lp.title}</li>)}
              </ol>
            </div>
            <div class="pm-keys" style="--i: 2">
              {site.learningPaths.map((lp) => <span class="pm-key"><i></i>{lp.title}</span>)}
            </div>
            <div class="pm-bubble pm-coach" style="--i: 3" data-time="5:16 PM">
              <Voice time="0:09" bars={18} />
              <p>The next topic is customer care. The first step in customer care is identifying the type of customer.</p>
            </div>
            <div class="pm-keys" style="--i: 4">
              <span class="pm-key">Continue</span>
            </div>
          </PhoneMock>
        </div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-green">Learn</p>
        <h3 class="mt-2 text-lg font-bold leading-snug text-alp-navy">Short lessons you can read or listen to</h3>
        <p class="mt-2 text-sm leading-relaxed text-alp-muted">
          Learners pick a learning path, a category and a course from the menu. Each lesson arrives as a
          short message with its audio version, and Continue moves to the next one.
        </p>
      </article>

      <!-- Check -->
      <article class={cardClass}>
        <div class={mockClass}>
          <PhoneMock compact label="Quiz preview">
            <div class="pm-bubble pm-coach" style="--i: 1" data-time="5:19 PM">
              <p>Are you ready to test your knowledge with a quick quiz?</p>
            </div>
            <div class="pm-keys" style="--i: 2">
              <span class="pm-key">Yes, I'm Ready!</span>
            </div>
            <div class="pm-bubble pm-coach" style="--i: 3" data-time="5:20 PM">
              <p>Which of the following is a Convenience Factor?</p>
              <ul class="pm-list">
                <li>A: Well-trained staff</li>
                <li>B: Payment Terms</li>
                <li>C: Product Quality</li>
                <li>D: All of the above</li>
              </ul>
            </div>
            <div class="pm-keys pm-keys--2" style="--i: 4">
              <span class="pm-key">A</span>
              <span class="pm-key">B</span>
              <span class="pm-key">C</span>
              <span class="pm-key">D</span>
            </div>
            <div class="pm-bubble pm-coach" style="--i: 5" data-time="5:20 PM">
              <p>Congratulations! You've answered that question correctly.</p>
            </div>
          </PhoneMock>
        </div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-green">Check</p>
        <h3 class="mt-2 text-lg font-bold leading-snug text-alp-navy">A quiz after every course</h3>
        <p class="mt-2 text-sm leading-relaxed text-alp-muted">
          Multiple-choice questions confirm understanding. Learners tap an answer, get an explanation
          either way, and see their progress before moving to the next course.
        </p>
      </article>

      <!-- Ask -->
      <article class={cardClass}>
        <div class={mockClass}>
          <PhoneMock compact label="Question preview">
            <div class="pm-bubble pm-user" style="--i: 1" data-time="5:43 PM">
              My customer always complains my price is too high. What should I do?
            </div>
            <div class="pm-bubble pm-coach" style="--i: 2" data-time="5:43 PM">
              <p>To address your customer's concern about your price being too high, you can consider the
              following strategies:</p>
              <ol class="pm-list">
                <li>1. Adjust your price: evaluate if you can slightly lower your price while still covering your costs and maintaining a profit.</li>
                <li>2. Emphasize value and benefits: highlight the quality, customer service or convenience that justify the current price.</li>
                <li>3. Offer promotions or discounts: limited-time offers attract customers without permanently lowering your prices.</li>
              </ol>
            </div>
            <div class="pm-keys" style="--i: 3">
              <span class="pm-key">Listen to the answer</span>
            </div>
          </PhoneMock>
        </div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-green">Ask</p>
        <h3 class="mt-2 text-lg font-bold leading-snug text-alp-navy">A coach that answers from ALP content only</h3>
        <p class="mt-2 text-sm leading-relaxed text-alp-muted">
          Type a question at any time. Answers are grounded in the validated ALP curriculum rather than
          general internet knowledge, and include diagrams and images where they help.
        </p>
      </article>

      <!-- Speak -->
      <article class={cardClass}>
        <div class={mockClass}>
          <PhoneMock compact label="Voice preview">
            <div class="pm-bubble pm-user pm-voice-only" style="--i: 1" data-time="5:45 PM" aria-label="Voice message, 4 seconds">
              <Voice time="0:04" bars={16} />
            </div>
            <div class="pm-bubble pm-coach" style="--i: 2" data-time="5:45 PM">
              <p class="pm-muted">You asked: how do I keep my stock records?</p>
              <p>Record every item that comes in and goes out on the same day, in one book or sheet. Count
              your stock at the end of each week and compare it with the book, so you notice any difference
              early.</p>
            </div>
            <div class="pm-keys" style="--i: 3">
              <span class="pm-key">Listen to the answer</span>
            </div>
            <div class="pm-bubble pm-coach pm-voice-only" style="--i: 4" data-time="5:45 PM" aria-label="Spoken answer, 18 seconds">
              <Voice time="0:18" bars={18} />
            </div>
          </PhoneMock>
        </div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-green">Speak</p>
        <h3 class="mt-2 text-lg font-bold leading-snug text-alp-navy">Voice in, voice out</h3>
        <p class="mt-2 text-sm leading-relaxed text-alp-muted">
          Learners who prefer speaking can send a voice note and hear the reply. Voice works in the
          learner's chosen language, so the coach sounds local rather than translated.
        </p>
      </article>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        facts.map((f) => (
          <div class="rounded-2xl bg-alp-surface p-6">
            <svg class="h-7 w-7 text-alp-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={f.icon}></path>
            </svg>
            <h3 class="mt-3 font-bold text-alp-navy">{f.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-alp-muted">{f.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
