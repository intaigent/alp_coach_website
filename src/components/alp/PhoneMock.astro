---
// Phone frame that reproduces the ALP Coach Telegram chat: green chat background,
// white bot bubbles (voice player + text), light-green user bubbles, translucent
// inline buttons under a message, and the blue "Menu" pill next to the field.
// Put bubbles in the default slot. Global "pm-*" classes, see Hero / HowItWorks.
interface Props {
  compact?: boolean;
  live?: boolean; // bubbles are revealed by a script instead of the CSS stagger
  label?: string;
}
const { compact = false, live = false, label = "ALP Coach chat preview" } = Astro.props;
---

<div class:list={["pm-phone", { "pm-phone--compact": compact, "pm-phone--live": live }]} aria-label={label}>
  <div class="pm-screen">
    <div class="pm-notch" aria-hidden="true"></div>

    <header class="pm-header">
      <span class="pm-back" aria-hidden="true"></span>
      <div class="pm-title-wrap">
        <p class="pm-name">ALP Coach</p>
        <p class="pm-sub">bot</p>
      </div>
      <div class="pm-avatar" aria-hidden="true">
        <img src="/images/alp/brand/alp-mark.png" alt="" width="40" height="40" />
      </div>
    </header>

    <div class:list={["pm-body", { "pm-body--live": live }]}>
      <slot />
    </div>

    <footer class="pm-input" aria-hidden="true">
      <span class="pm-menu"><i></i>Menu</span>
      <span class="pm-clip"></span>
      <span class="pm-field" data-pm-field data-placeholder="Message">Message</span>
      <span class="pm-mic"></span>
    </footer>
  </div>
</div>

<style is:global>
  .pm-phone {
    --pm-fs: 12.5px;
    --pm-radius: 44px;
    --pm-pad: 10px;
    --pm-top: 46px;
    --pm-blue: #3390ec;
    --pm-ink: #0f1f14;
    width: 100%;
    max-width: 300px;
    margin-inline: auto;
    padding: var(--pm-pad);
    border-radius: var(--pm-radius);
    background: #0b1b2e;
    box-shadow:
      0 30px 60px -20px rgba(0, 35, 69, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.06) inset;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--pm-ink);
  }
  .pm-phone--compact {
    --pm-fs: 11px;
    --pm-radius: 34px;
    --pm-pad: 7px;
    --pm-top: 36px;
    max-width: 230px;
    box-shadow: 0 18px 40px -18px rgba(0, 35, 69, 0.4);
  }
  .pm-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 9 / 18.6;
    overflow: hidden;
    isolation: isolate;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    border-radius: calc(var(--pm-radius) - var(--pm-pad) + 2px);
    background:
      radial-gradient(120% 60% at 20% 0%, rgba(255, 255, 255, 0.22), transparent 60%),
      linear-gradient(170deg, #d6e6c6 0%, #bfd6ad 45%, #a9c79a 100%);
  }
  .pm-notch {
    position: absolute;
    top: 9px;
    left: 50%;
    width: 30%;
    height: calc(var(--pm-top) * 0.42);
    transform: translateX(-50%);
    border-radius: 999px;
    background: #0b1b2e;
    z-index: 2;
  }
  .pm-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: var(--pm-top) 12px 8px;
    background: rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .pm-back {
    width: 9px;
    height: 9px;
    margin-left: 4px;
    border-left: 2px solid var(--pm-blue);
    border-bottom: 2px solid var(--pm-blue);
    transform: rotate(45deg);
    flex: none;
  }
  .pm-title-wrap {
    flex: 1;
    text-align: center;
  }
  .pm-name {
    margin: 0;
    font-size: calc(var(--pm-fs) * 1.08);
    font-weight: 700;
    line-height: 1.1;
  }
  .pm-sub {
    margin: 2px 0 0;
    font-size: calc(var(--pm-fs) * 0.8);
    color: #6b7c72;
    line-height: 1;
  }
  .pm-avatar {
    display: grid;
    place-items: center;
    width: calc(var(--pm-fs) * 2.4);
    height: calc(var(--pm-fs) * 2.4);
    border-radius: 999px;
    background: #fff;
    overflow: hidden;
    flex: none;
  }
  .pm-avatar img {
    width: 68%;
    height: 68%;
    object-fit: contain;
  }
  .pm-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 8px 8px;
    overflow: hidden;
  }
  .pm-day {
    align-self: center;
    margin: 0 0 2px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.12);
    font-size: calc(var(--pm-fs) * 0.78);
    font-weight: 600;
    color: #fff;
  }

  /* Bubbles */
  .pm-bubble {
    position: relative;
    max-width: 90%;
    padding: 6px 9px 7px;
    border-radius: 12px;
    font-size: var(--pm-fs);
    line-height: 1.38;
    background: #fff;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transform: translateY(8px);
    animation: pm-bubble-in 0.5s ease-out forwards;
    animation-delay: calc(var(--i, 1) * 0.35s + 0.2s);
  }
  .pm-bubble p {
    margin: 0;
  }
  .pm-bubble p + p {
    margin-top: 4px;
  }
  .pm-bubble strong {
    font-weight: 700;
  }
  .pm-coach {
    align-self: flex-start;
    border-bottom-left-radius: 3px;
  }
  .pm-user {
    align-self: flex-end;
    background: #effdde;
    border-bottom-right-radius: 3px;
  }
  .pm-bubble[data-time]::after {
    content: attr(data-time);
    display: block;
    margin-top: 2px;
    text-align: right;
    font-size: calc(var(--pm-fs) * 0.72);
    color: #8a9a90;
  }
  .pm-user[data-time]::after {
    color: #5fa15a;
  }
  .pm-muted {
    color: #6b7c72;
  }

  /* Voice player row (bot lessons and voice notes) */
  .pm-voice {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 5px;
  }
  .pm-play {
    position: relative;
    width: calc(var(--pm-fs) * 2.2);
    height: calc(var(--pm-fs) * 2.2);
    border-radius: 999px;
    background: var(--pm-blue);
    flex: none;
  }
  .pm-play::before {
    content: "";
    position: absolute;
    left: 55%;
    top: 50%;
    width: 0;
    height: 0;
    transform: translate(-50%, -50%);
    border-left: calc(var(--pm-fs) * 0.75) solid #fff;
    border-top: calc(var(--pm-fs) * 0.45) solid transparent;
    border-bottom: calc(var(--pm-fs) * 0.45) solid transparent;
  }
  .pm-wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 16px;
    color: var(--pm-blue);
  }
  .pm-wave i {
    display: block;
    width: 2px;
    height: var(--h);
    border-radius: 2px;
    background: currentColor;
    opacity: 0.8;
  }
  .pm-time {
    font-size: calc(var(--pm-fs) * 0.78);
    color: #6b7c72;
  }
  .pm-voice-only {
    padding-bottom: 6px;
  }
  .pm-voice-only .pm-voice {
    margin-bottom: 0;
  }

  /* Inline keyboard buttons under a message */
  .pm-keys {
    display: grid;
    gap: 4px;
    width: 92%;
    align-self: stretch;
    opacity: 0;
    transform: translateY(8px);
    animation: pm-bubble-in 0.5s ease-out forwards;
    animation-delay: calc(var(--i, 1) * 0.35s + 0.2s);
  }
  .pm-keys--2 {
    grid-template-columns: 1fr 1fr;
  }
  .pm-key {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: calc(var(--pm-fs) * 2.3);
    padding: 4px 8px;
    border-radius: 8px;
    background: rgba(70, 122, 62, 0.78);
    color: #fff;
    font-size: calc(var(--pm-fs) * 0.95);
    font-weight: 600;
    text-align: center;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08);
  }
  .pm-key i {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #2ecc40;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12) inset;
    flex: none;
  }
  .pm-key--dim {
    opacity: 0.55;
  }

  /* Bottom bar */
  .pm-input {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 8px 16px;
    background: rgba(255, 255, 255, 0.92);
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }
  .pm-menu {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--pm-blue);
    color: #fff;
    font-size: calc(var(--pm-fs) * 0.88);
    font-weight: 600;
    flex: none;
  }
  .pm-menu i {
    width: 9px;
    height: 7px;
    border-top: 1.5px solid #fff;
    border-bottom: 1.5px solid #fff;
    position: relative;
  }
  .pm-menu i::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
    background: #fff;
  }
  .pm-clip {
    width: 10px;
    height: 16px;
    border: 1.5px solid #8a9a90;
    border-radius: 6px 6px 8px 8px;
    flex: none;
    transform: rotate(35deg);
  }
  .pm-field {
    flex: 1;
    min-width: 0;
    padding: 6px 10px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    font-size: calc(var(--pm-fs) * 0.95);
    color: #8a9a90;
    white-space: nowrap;
    overflow: hidden;
  }
  .pm-mic {
    width: 12px;
    height: 16px;
    border: 1.5px solid #8a9a90;
    border-radius: 999px;
    flex: none;
    position: relative;
  }
  .pm-mic::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 1.5px;
    height: 5px;
    background: #8a9a90;
    transform: translateX(-50%);
  }

  /* Live mode: script controls the reveal; newest message stays visible. */
  .pm-body--live {
    justify-content: flex-end;
    transition: opacity 0.4s ease;
  }
  .pm-body--live.is-resetting {
    opacity: 0;
  }
  .pm-body--live .pm-bubble:not(.is-on),
  .pm-body--live .pm-keys:not(.is-on) {
    display: none;
  }
  .pm-body--live .pm-bubble,
  .pm-body--live .pm-keys {
    animation: none;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s ease-out,
      transform 0.35s ease-out;
  }
  .pm-body--live .pm-bubble.is-in,
  .pm-body--live .pm-keys.is-in {
    opacity: 1;
    transform: none;
  }
  .pm-typing {
    display: flex;
    gap: 4px;
    padding: 9px 11px;
  }
  .pm-typing i {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #8a9a90;
    animation: pm-typing 1.2s ease-in-out infinite;
  }
  .pm-typing i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .pm-typing i:nth-child(3) {
    animation-delay: 0.4s;
  }
  .pm-field.is-typing {
    color: var(--pm-ink);
  }
  .pm-field.is-typing::after {
    content: "";
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin-left: 1px;
    vertical-align: -0.1em;
    background: var(--pm-ink);
    animation: pm-caret 1s steps(2) infinite;
  }
  @keyframes pm-typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    30% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }
  @keyframes pm-caret {
    to {
      opacity: 0;
    }
  }
  @keyframes pm-bubble-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pm-body--live .pm-bubble:not(.is-on) {
      display: block;
    }
    .pm-body--live .pm-keys:not(.is-on) {
      display: grid;
    }
    .pm-bubble,
    .pm-keys,
    .pm-body--live .pm-bubble,
    .pm-body--live .pm-keys {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
    .pm-typing i,
    .pm-field.is-typing::after {
      animation: none;
    }
  }
</style>
