---
// Designed phone frame with an ALP Coach chat header and input bar.
// Put message bubbles in the default slot (see Hero and HowItWorks for markup).
// Styles are global so slotted bubbles pick them up; classes are prefixed "pm-".
interface Props {
  compact?: boolean;
  live?: boolean; // bubbles are revealed by a script instead of the CSS stagger
  label?: string;
}
const { compact = false, live = false, label = "ALP Coach chat preview" } = Astro.props;
---

<div class:list={["pm-phone", { "pm-phone--compact": compact, "pm-phone--live": live }]} aria-label={label}>
  <div class="pm-screen">
    <div class="pm-notch" aria-hidden="true"></div>

    <header class="pm-header">
      <div class="pm-avatar" aria-hidden="true">
        <img src="/images/alp/brand/alp-mark.png" alt="" width="40" height="40" />
      </div>
      <div>
        <p class="pm-name">ALP Coach</p>
        <p class="pm-status">online</p>
      </div>
    </header>

    <div class:list={["pm-body", { "pm-body--live": live }]}>
      <slot />
    </div>

    <footer class="pm-input" aria-hidden="true">
      <span class="pm-field" data-pm-field data-placeholder="Ask the coach…">Ask the coach…</span>
      <span class="pm-mic"></span>
    </footer>
  </div>
</div>

<style is:global>
  .pm-phone {
    --pm-fs: 12.5px;
    --pm-radius: 44px;
    --pm-pad: 10px;
    --pm-top: 50px;
    width: 100%;
    max-width: 300px;
    margin-inline: auto;
    padding: var(--pm-pad);
    border-radius: var(--pm-radius);
    background: #0b1b2e;
    box-shadow:
      0 30px 60px -20px rgba(0, 35, 69, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.06) inset;
    font-family: Urbanist, ui-sans-serif, system-ui, sans-serif;
    color: #002345;
  }
  .pm-phone--compact {
    --pm-fs: 11px;
    --pm-radius: 34px;
    --pm-pad: 7px;
    --pm-top: 38px;
    max-width: 230px;
    box-shadow: 0 18px 40px -18px rgba(0, 35, 69, 0.4);
  }
  .pm-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 9 / 18.6;
    overflow: hidden;
    border-radius: calc(var(--pm-radius) - var(--pm-pad) + 2px);
    background: #f4f8f5;
  }
  .pm-notch {
    position: absolute;
    top: 9px;
    left: 50%;
    width: 30%;
    height: calc(var(--pm-top) * 0.42);
    transform: translateX(-50%);
    border-radius: 999px;
    background: #0b1b2e;
    z-index: 2;
  }
  .pm-header {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: var(--pm-top) 14px 10px;
    background: #fff;
    border-bottom: 1px solid #d6e4da;
  }
  .pm-avatar {
    display: grid;
    place-items: center;
    width: calc(var(--pm-fs) * 2.7);
    height: calc(var(--pm-fs) * 2.7);
    border-radius: 999px;
    background: #f4f8f5;
    border: 1px solid #d6e4da;
    overflow: hidden;
  }
  .pm-avatar img {
    width: 65%;
    height: 65%;
    object-fit: contain;
  }
  .pm-name {
    margin: 0;
    font-size: calc(var(--pm-fs) * 1.1);
    font-weight: 700;
    line-height: 1.1;
  }
  .pm-status {
    margin: 2px 0 0;
    font-size: calc(var(--pm-fs) * 0.85);
    color: #008540;
    line-height: 1;
  }
  .pm-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 12px 10px 8px;
    overflow: hidden;
  }
  .pm-day {
    margin: 0 0 3px;
    text-align: center;
    font-size: calc(var(--pm-fs) * 0.78);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #587083;
  }
  .pm-bubble {
    max-width: 88%;
    padding: 8px 11px;
    border-radius: 15px;
    font-size: var(--pm-fs);
    line-height: 1.4;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 35, 69, 0.08);
    opacity: 0;
    transform: translateY(8px);
    animation: pm-bubble-in 0.5s ease-out forwards;
    animation-delay: calc(var(--i, 1) * 0.35s + 0.2s);
  }
  .pm-bubble p {
    margin: 0;
  }
  .pm-bubble p + p {
    margin-top: 5px;
  }
  .pm-coach {
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }
  .pm-user {
    align-self: flex-end;
    background: #008540;
    color: #fff;
    border-bottom-right-radius: 4px;
    font-weight: 500;
  }
  .pm-meta {
    font-size: calc(var(--pm-fs) * 0.84);
    color: #587083;
  }
  .pm-voice {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
  }
  .pm-play {
    width: 0;
    height: 0;
    border-left: 7px solid currentColor;
    border-top: 4.5px solid transparent;
    border-bottom: 4.5px solid transparent;
  }
  .pm-coach .pm-play {
    color: #008540;
  }
  .pm-wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 14px;
  }
  .pm-wave i {
    display: block;
    width: 2px;
    height: var(--h);
    border-radius: 2px;
    background: currentColor;
    opacity: 0.85;
  }
  .pm-coach .pm-wave i {
    background: #002345;
    opacity: 0.55;
  }
  .pm-time {
    font-size: calc(var(--pm-fs) * 0.84);
    opacity: 0.85;
  }
  .pm-input {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 10px 16px;
    background: #fff;
    border-top: 1px solid #d6e4da;
  }
  .pm-field {
    flex: 1;
    padding: 7px 11px;
    border-radius: 999px;
    border: 1px solid #d6e4da;
    font-size: calc(var(--pm-fs) * 0.95);
    color: #587083;
  }
  .pm-mic {
    width: calc(var(--pm-fs) * 2.3);
    height: calc(var(--pm-fs) * 2.3);
    border-radius: 999px;
    background: #008540;
    position: relative;
  }
  .pm-mic::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20%;
    height: 34%;
    transform: translate(-50%, -60%);
    border-radius: 3px;
    background: #fff;
  }
  /* Live mode: script controls the reveal; newest message stays visible. */
  .pm-body--live {
    justify-content: flex-end;
    transition: opacity 0.4s ease;
  }
  .pm-body--live.is-resetting {
    opacity: 0;
  }
  .pm-body--live .pm-bubble:not(.is-on) {
    display: none;
  }
  .pm-body--live .pm-bubble {
    animation: none;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s ease-out,
      transform 0.35s ease-out;
  }
  .pm-body--live .pm-bubble.is-in {
    opacity: 1;
    transform: none;
  }
  .pm-typing {
    display: flex;
    gap: 4px;
    padding: 10px 12px;
  }
  .pm-typing i {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #587083;
    animation: pm-typing 1.2s ease-in-out infinite;
  }
  .pm-typing i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .pm-typing i:nth-child(3) {
    animation-delay: 0.4s;
  }
  .pm-field.is-typing {
    color: #002345;
  }
  .pm-field.is-typing::after {
    content: "";
    display: inline-block;
    width: 1px;
    height: 0.9em;
    margin-left: 1px;
    vertical-align: -0.1em;
    background: #002345;
    animation: pm-caret 1s steps(2) infinite;
  }
  @keyframes pm-typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    30% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }
  @keyframes pm-caret {
    to {
      opacity: 0;
    }
  }
  @keyframes pm-bubble-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pm-body--live .pm-bubble:not(.is-on) {
      display: block;
    }
    .pm-body--live .pm-voice:not(.is-on) {
      display: flex;
    }
    .pm-bubble,
    .pm-body--live .pm-bubble {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
    .pm-typing i,
    .pm-field.is-typing::after {
      animation: none;
    }
  }
</style>
