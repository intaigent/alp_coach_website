---
import { site } from "../../config/site";
const { telegram, whatsapp, languages } = site;

const statusLabel: Record<string, string> = {
  available: "Available now",
  country: "Live in country deployments",
  planned: "Coming with country launches",
};
const statusClass: Record<string, string> = {
  available: "border-alp-green bg-alp-green text-white",
  country: "border-alp-green/40 bg-white text-alp-green",
  planned: "border-alp-border bg-white text-alp-muted",
};

const channels = [
  {
    name: "Telegram",
    logo: "/images/telegram-logo.svg",
    live: telegram.live,
    url: telegram.url,
    qr: telegram.qr,
    cta: `Open @${telegram.handle}`,
    hint: "Scan with your phone camera or tap the button.",
  },
  {
    name: "WhatsApp",
    logo: "/images/whatsapp-logo.svg",
    live: whatsapp.live,
    url: whatsapp.url,
    qr: whatsapp.qr,
    cta: `Message ${whatsapp.displayNumber}`,
    hint: "Save the number or scan the code, then send any message to start.",
  },
];
const anyLive = channels.some((c) => c.live);
---

<section id="try" class="reveal bg-alp-surface py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 md:px-12 xl:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-alp-green">Try it</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-alp-navy sm:text-4xl">
        Get in the driver's seat
      </h2>
      <p class="mt-4 text-lg text-alp-muted">
        {
          anyLive
            ? "Scan or tap, say hello, and register in about a minute. Then take a lesson or ask the coach a question."
            : "The same coach on both channels: register in about a minute, then take a lesson or ask a question. Access details will be published here."
        }
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        channels.map((c) => (
          <div class="flex flex-col items-center rounded-3xl border border-alp-border bg-white p-8 text-center shadow-sm">
            <div class="flex items-center gap-2">
              <img src={c.logo} alt="" class="h-7 w-7" width="28" height="28" />
              <h3 class="text-xl font-bold text-alp-navy">{c.name}</h3>
              {c.live ? (
                <span class="ml-2 rounded-full bg-alp-bright/15 px-2.5 py-0.5 text-xs font-bold text-alp-green">Live</span>
              ) : (
                <span class="ml-2 rounded-full bg-alp-yellow/40 px-2.5 py-0.5 text-xs font-bold text-alp-navy">Coming soon</span>
              )}
            </div>
            {c.live ? (
              <>
                {c.qr && (
                  <img src={c.qr} alt={`QR code for ${c.url}`} class="mt-6 h-44 w-44 rounded-xl border border-alp-border" width="290" height="290" loading="lazy" />
                )}
                <a
                  href={c.url}
                  target="_blank"
                  rel="noopener"
                  class="mt-6 inline-flex h-12 items-center rounded-full bg-alp-green px-6 text-base font-semibold text-white transition hover:bg-alp-navy"
                >
                  {c.cta}
                </a>
                <p class="mt-3 text-sm text-alp-muted">{c.hint}</p>
              </>
            ) : (
              <>
                <div class="mt-6 flex h-44 w-44 items-center justify-center rounded-xl border border-dashed border-alp-border bg-alp-surface" aria-hidden="true">
                  <img src={c.logo} alt="" class="h-14 w-14 opacity-30 grayscale" width="56" height="56" />
                </div>
                <p class="mt-6 max-w-xs text-alp-muted">
                  The QR code and link for {c.name} will appear here at launch.
                </p>
              </>
            )}
          </div>
        ))
      }
    </div>

    <div class="mt-12 rounded-3xl border border-alp-border bg-white p-6 sm:p-8">
      <div>
        <h3 class="text-lg font-bold text-alp-navy">Languages</h3>
        <p class="mt-1 text-sm text-alp-muted">
          Adding a language is configuration, not a new bot. Local languages arrive with each country launch.
        </p>
      </div>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          languages.map((l) => (
            <li class:list={["inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-sm font-semibold", statusClass[l.status]]}>
              {l.name}
              <span class="text-[11px] font-medium opacity-80">· {statusLabel[l.status]}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
