---
// Static waveform bars for a voice-note bubble.
const heights = [3, 6, 9, 5, 12, 8, 4, 10, 7, 13, 6, 9, 4, 11, 8, 5, 12, 7, 3, 9, 6, 4];
interface Props {
  bars?: number;
}
const { bars = 22 } = Astro.props;
---

<span class="pm-wave" aria-hidden="true">
  {heights.slice(0, bars).map((h) => <i style={`--h: ${h}px`}></i>)}
</span>
